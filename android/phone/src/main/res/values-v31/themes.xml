<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nobelle" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nobelle_canvas</item>
        <item name="android:statusBarColor">@color/nobelle_burgundy</item>
        <item name="android:navigationBarColor">@color/nobelle_ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/nobelle_icon_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_nobelle_foreground</item>
        <!-- postSplashScreenTheme is a compat-library attr; Theme.Nobelle
             is already the activity theme shown after the splash. -->
    </style>
</resources>
